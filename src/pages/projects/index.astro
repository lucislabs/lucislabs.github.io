---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
const projects = (await getCollection('projects')).sort((a, b) => b.data.year - a.data.year);
---
<Base title="Projects" description="Data science and geospatial projects.">
  <div class="wrap">
    <div class="page-head"><p class="eyebrow">work</p><h1>Projects</h1></div>
    <div class="grid">
      {projects.map((p) => (
        <a class="card" href={`/projects/${p.id}/`}>
          <span class={`tag ${p.data.kind}`}>{p.data.kind}</span><span class="tag">{p.data.year}</span>
          <h3>{p.data.title}</h3>
          <p class="mute">{p.data.summary}</p>
          <div>{p.data.stack.map((s) => <span class="tag">{s}</span>)}</div>
        </a>
      ))}
    </div>
  </div>
</Base>
<style>h3 { margin: 8px 0; font-size: 1.1rem; }</style>
